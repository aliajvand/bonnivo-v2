# ==========================================
# BONYO ECOSYSTEM - ENVIRONMENT TEMPLATE
# ==========================================
# توجه: این فایل یک نمونه با مقادیر خالی است.
# مقادیر واقعی را در فایل .env در ریشه پروژه قرار دهید (که در .gitignore است).
# هرگز هیچ کلیدی نباید با پیشوند NEXT_PUBLIC_ برای اسرار بک‌اند استفاده شود.

# --- Platform & Runtime Mode ---
NODE_ENV=development
APP_ENV=development
DEBUG=true
DEMO_MODE=false

# --- Database Connections ---
DATABASE_URL=sqlite+aiosqlite:///./bonnivo.db
DATABASE_TEST_URL=sqlite+aiosqlite:///:memory:

# --- Security, Authentication & Session ---
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
RATE_LIMIT_ENABLED=true

# --- SMS Gateway (sms.ir API v1) ---
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_LINE_NUMBER=
SMSIR_OTP_PARAM_NAME=Code
# سازگاری با نام‌های جایگزین
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=
SMS_IR_LINE_NUMBER=

# --- Test Target Numbers ---
TEST_PHONE=
SMS_TEST_PHONE=
SMS_TEST_MAX_SENDS=5

# --- OTP Security Policy ---
OTP_LENGTH=5
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# --- AI Integration (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_RETRIES=2

# --- Payment Gateway (ZarinPal / Sandbox) ---
PAYMENT_PROVIDER=zarinpal
ZARINPAL_MERCHANT_ID=
PAYMENT_SANDBOX=true
PAYMENT_CALLBACK_URL=http://localhost:3000/checkout/callback

# --- Admin Panel (WordPress-style) Security ---
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15
ADMIN_SESSION_HOURS=8
ADMIN_REMEMBER_DAYS=14
ADMIN_RESET_TOKEN_TTL_MINUTES=30
ENABLE_ADMIN_2FA=false

# --- Non-Secret Public URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000