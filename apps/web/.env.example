# BONYO NEXT.JS WEB ENVIRONMENT TEMPLATE
# NEVER place backend secrets (SMS_IR_API_KEY, GROQ_API_KEY, DB_PASSWORDS) in NEXT_PUBLIC_* variables

# Client Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Feature Flags
NEXT_PUBLIC_ENABLE_3D_ISLAND=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_DEFAULT_THEME=dark

# QA Accounts (For Simulation & Quick Login in Dev Only)
NEXT_PUBLIC_QA_CUSTOMER_PHONE=09120000001
NEXT_PUBLIC_QA_ADMIN_PHONE=09120000002
NEXT_PUBLIC_QA_VET_PHONE=09120000003
NEXT_PUBLIC_QA_ORGANIZER_PHONE=09120000004
NEXT_PUBLIC_QA_TRAINER_PHONE=09120000005
