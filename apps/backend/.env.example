# BONYO FASTAPI BACKEND ENVIRONMENT TEMPLATE
# Keep this file tracked in Git with placeholders only.

# Core Settings
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bonnivo_dev
SQL_DEBUG=false

# Authentication
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# External Integrations (Server-side Only)
SMS_IR_API_KEY=REPLACE_ME
SMS_IR_LINE_NUMBER=REPLACE_ME
GROQ_API_KEY=REPLACE_ME
GROQ_MODEL=llama-3.3-70b-versatile

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","exp://*"]

# QA Test & Dev Seed Credentials
QA_SEED_ENABLED=true
QA_CUSTOMER_EMAIL=customer@test.bonyo.local
QA_CUSTOMER_PHONE=09120000001
QA_ADMIN_EMAIL=admin@test.bonyo.local
QA_ADMIN_PHONE=09120000002
QA_VET_EMAIL=vet@test.bonyo.local
QA_VET_PHONE=09120000003
QA_ORGANIZER_EMAIL=organizer@test.bonyo.local
QA_ORGANIZER_PHONE=09120000004
QA_TRAINER_EMAIL=trainer@test.bonyo.local
QA_TRAINER_PHONE=09120000005
QA_DEFAULT_OTP=12345
